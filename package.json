{
  "name": "@moreflow/chatbots",
  "version": "0.2.0",
  "description": "Headless browser protocol helpers for Moreflow public chatbots.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreflow-io/chatbots.git"
  },
  "homepage": "https://github.com/moreflow-io/chatbots#readme",
  "bugs": {
    "url": "https://github.com/moreflow-io/chatbots/issues"
  },
  "keywords": [
    "moreflow",
    "chatbot",
    "headless",
    "browser",
    "sse"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --external:@moreflow/tracking --format=esm --minify --outfile=dist/index.js && tsc --singleThreaded -p tsconfig.build.json",
    "typecheck": "tsc --singleThreaded --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {
    "@moreflow/tracking": "^0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
