{
  "name": "@moreflow/chatbots",
  "version": "0.4.1",
  "description": "Headless public-chatbot helpers, a chatbot session store and an optional React hook.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreflow-io/chatbots.git"
  },
  "homepage": "https://github.com/moreflow-io/chatbots#readme",
  "bugs": {
    "url": "https://github.com/moreflow-io/chatbots/issues"
  },
  "keywords": [
    "moreflow",
    "chatbot",
    "headless",
    "browser",
    "sse",
    "react"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "jsdelivr": "./dist/browser.js",
  "unpkg": "./dist/browser.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./browser": "./dist/browser.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts src/react.ts --bundle --splitting --external:@moreflow/tracking --external:react --format=esm --minify --outdir=dist --chunk-names=chunks/[name]-[hash] && esbuild src/index.ts --bundle --format=iife --global-name=MoreflowChatbots --target=es2019 --minify --outfile=dist/browser.js && tsc --singleThreaded -p tsconfig.build.json",
    "typecheck": "tsc --singleThreaded --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build && bun run test"
  },
  "dependencies": {
    "@moreflow/tracking": "^0.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.2",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
